{
  "displayName": "EVCC",
  "name": "homebridge-evcc",
  "version": "0.1.0",
  "description": "Homebridge plugin for the EVCC solar charging controller. Exposes loadpoints, vehicles, home battery, PV production, and grid power as native HomeKit accessories with a charge-limit slider you can drive from the Home app or Siri.",
  "license": "MIT",
  "author": {
    "name": "Matthias Einig",
    "url": "https://github.com/matthiaseinig"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/matthiaseinig"
    }
  ],
  "homepage": "https://github.com/matthiaseinig/Homebridge-EVCC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiaseinig/Homebridge-EVCC.git"
  },
  "bugs": {
    "url": "https://github.com/matthiaseinig/Homebridge-EVCC/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.20.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "npm run build && homebridge -U ./dev -P .",
    "preflight": "npm run lint && npm run build && npm run test:coverage && npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run preflight"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "evcc",
    "ev",
    "charging",
    "solar",
    "pv",
    "wallbox",
    "smart-charging"
  ],
  "files": [
    "dist/",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "homebridge": "^1.8.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
